{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"customManagers": [
		{
		  "customType": "regex",
		  "fileMatch": ["version.go"],
		  "matchStrings": [
			"crsVersion\\s+=\\s+\"(?<currentValue>v[^\"]+)\""
		  ],
		  "datasourceTemplate": "github-releases",
		  "depNameTemplate": "coreruleset/coreruleset"
		},
		{
			"customType": "regex",
			"fileMatch": ["version.go"],
			"matchStrings": [
			  "corazaVersion\\s+=\\s+\"(?<currentValue>v[^\"]+)\""
			],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "corazawaf/coraza"
		  }
	  ],
	"packageRules": [
		{
			"matchDepNames": ["coreruleset/coreruleset"],
			"semanticCommitType": "feat",
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"matchDepNames": ["corazawaf/coraza"],
			"semanticCommitType": "fix",
			"automerge": true,
			"automergeType": "pr"
		}
	],
	"postUpdateOptions": [
		"gomodTidy"
	]
}

